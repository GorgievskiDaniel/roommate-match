# Copy to backend/.env. That file stays out of git.
GEMINI_API_KEY=your-key-from-google-ai-studio

# E-mail. Without these lines, everything goes to the local mail catcher at http://localhost:8025.
# With them, e-mails reach any address students enter: Gmail, Outlook or any other provider.
# The Gmail account below only sends them. It needs 2-Step Verification and an app password
# from https://myaccount.google.com/apppasswords.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
# Optional. By default the sender is "Roommate Match <MAIL_USERNAME>".
# MAIL_FROM=Roommate Match <your-address@gmail.com>
